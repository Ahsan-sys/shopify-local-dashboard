# Reference only. Spring Boot does NOT automatically load this file.
# Pass these names as JVM system properties (-DNAME=value) before -jar.
# Keep real values outside the repository. See README.md.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# No SMTP service or configurable email address is needed.
# Shopify sends any requested customer notification to the order's customer.
